[? if psu_formed and not anti_fas_psu : {!<tr><td>!} -PSU {!</td></tr>!} ?]

[? if psu_formed and psri_joint_psu and not anti_fas_psu : {!<tr><td>!} -PSRI {!</td></tr>!} ?]

[? if pll_formed and not anti_fas_pll : {!<tr><td><div class="box" style='background-color:#FFD1D9'> </div>!} <span style="color: [+ ds_colour +];">Liberal</span>-<span style="color: [+ psri_colour +];">Socialist</span> List: {!</td><td>!} [+ pll_r_disp +]% {!</td><td>!} [+ str_change_pll +]% {!</td><td>!} [+ pll_seating +] {!</td><td>!} [+ pll_seating_disp +]% {!</td></tr>!} ?]

[? if pll_formed and not anti_fas_pll : {!<tr><td>!} -PLL {!</td></tr>!} ?]

[? if (psri_stable or (psri_solo and psri_r >= 5)) and not anti_fas_psri : {!<tr><td><div class="box" style='background-color:#FFC0CB'> </div>!} <span style="color: [+ psri_colour +];">Moderate Socialist</span> List: {!</td><td>!} [+ psri_r_disp +]% {!</td><td>!} [+ str_change_psri +]% {!</td><td>!} [+ psri_seating +] {!</td><td>!} [+ psri_seating_disp +]% {!</td></tr>!} ?]

[? if (psri_stable or (psri_solo and psri_r >= 5)) and not anti_fas_psri : {!<tr><td>!} -PSRI {!</td></tr>!} ?]

[? if pri_prominent and not anti_fas_pri : {!<tr><td><div class="box" style='background-color:#3CB371'> </div>!} <span style="color: [+ pri_colour +];">Republican</span> List: {!</td><td>!} [+ pri_r_disp +]% {!</td><td>!} [+ str_change_pri +]% {!</td><td>!} [+ pri_seating +] {!</td><td>!} [+ pri_seating_disp +]% {!</td></tr>!} ?]

[? if pri_prominent and not anti_fas_pri : {!<tr><td>!} -PRI {!</td></tr>!} ?]

[? if pri_prominent and psri_joint_pri and not anti_fas_pri : {!<tr><td>!} -PSRI {!</td></tr>!} ?]

[? if (ds_list and not view_full) or ((ds_party and ds_leader = "Colonna") or (ds_leader = "Carnazza" and ds_party and (pnf_r < 5)) or (ds_party and ds_leader = "Giuffrida" and not ds_joint)) and not anti_fas_ds or pnf_in_government : {!<tr><td><div class="box" style='background-color:#1E99C5'> </div>!} <span style="color: [+ ds_colour +];">Democratic</span> List: {!</td><td>!} [+ ds_r_disp +]% {!</td><td>!} [+ str_change_ds +]% {!</td><td>!} [+ ds_seating +] {!</td><td>!} [+ ds_seating_disp +]% {!</td></tr>!} ?]

[? if (ds_list and not view_full) or ((ds_party and ds_leader = "Colonna") or (ds_leader = "Carnazza" and ds_party and (pnf_r < 5)) or (ds_party and ds_leader = "Giuffrida" and not ds_joint)) and not anti_fas_ds or pnf_in_government : {!<tr><td>!} -[+ ds_name +] {!</td></tr>!} ?]

[? if not pnf_in_power and (not anti_fas_ppi or not acerbo_law_passed) : {!<tr><td><div class="box" style='background-color:#87CEFA'> </div>!} <span style="color: [+ ppi_colour +];">Catholic</span> List: {!</td><td>!} [+ ppi_r_disp +]% {!</td><td>!} [+ str_change_ppi +]% {!</td><td>!} [+ ppi_seating +] {!</td><td>!} [+ ppi_seating_disp +]% {!</td></tr>!} ?]

[? if not pnf_in_power and (not anti_fas_ppi or not acerbo_law_passed) : {!<tr><td>!} -PPI {!</td></tr>!} ?]

[? if (ldr_party or ldr_list) and not pnf_in_power and not anti_fas_ldr : {!<tr><td><div class="box" style='background-color:#FFD700'> </div>!} <span style="color: [+ ldr_colour +];">Liberal, Democrats, and Radicals</span>: {!</td><td>!} [+ ldr_r +]% {!</td><td>!} [+ str_change_ldr +]% {!</td><td>!} [+ ldr_seating +] {!</td><td>!} [+ ldr_seating_disp +]% {!</td></tr>!} ?]

[? if ldr_party or (ldr_list and not view_full) and not pnf_in_power and not anti_fas_ldr : {!<tr><td>!} -PLDI {!</td></tr>!} ?]

[? if not ul_in_bn and not pnf_in_power and not anti_fas_ul : {!<tr><td><div class="box" style='background-color:#0047AB'> </div>!} <span style="color: [+ ul_colour +];">Liberal</span> List: {!</td><td>!} [+ ul_r +]% {!</td><td>!} [+ str_change_ul +]% {!</td><td>!} [+ ul_seating +] {!</td><td>!} [+ ul_seating_disp +]% {!</td></tr>!} ?]

[? if not ul_in_bn and not pnf_in_power and not anti_fas_ul : {!<tr><td>!} -PLI {!</td></tr>!} ?]

[? if bn_formed : {!<tr><td><div class="box" style='background-color:#0047AB'> </div>!} <span style="color: [+ bn_colour +];">National Bloc</span>: {!</td><td>!} [+ bn_r +]% {!</td><td>!} [+ str_change_bn +]% {!</td><td>!} [+ bn_seating +] {!</td><td>!} [+ bn_seating_disp +]% {!</td></tr>!} ?]

[? if ul_in_bn : {!<tr><td>!} -PLI {!</td></tr>!} ?]

[? if ani_in_bn : {!<tr><td>!} -ANI {!</td></tr>!} ?]

[? if pnf_in_bn : {!<tr><td>!} -[+ pnf_name +] {!</td></tr>!} ?]

[? if pcs_formed and pnf_r < 5 : {!<tr><td><div class="box" style='background-color:#656573'> </div>!} <span style="color: [+ pcs_colour +];">National-Conservative</span> List: {!</td><td>!} [+ pcs_r_disp +]% {!</td><td>!} [+ str_change_pcs +]% {!</td><td>!} [+ pcs_seating +] {!</td><td>!} [+ pcs_seating_disp +]% {!</td></tr>!} ?]

[? if pcs_formed and pnf_r < 5 : {!<tr><td>!} -PCS {!</td></tr>!} ?]

[? if not pnf_in_bn and (pnf_r >= 5) and not pnf_banned: {!<tr><td><div class="box" style='background-color:#000000'> </div>!} [? if not pnf_in_power : <span style="color: [+ pnf_colour +];">Fascist</span> List ?][? if pnf_in_power : National List ?]: {!</td><td>!} [+ pnf_r_disp +]% {!</td><td>!} [+ str_change_pnf +]% {!</td><td>!} [+ pnf_seating +] {!</td><td>!} [+ pnf_seating_disp +]% {!</td></tr>!} ?]

[? if not pnf_in_bn and (pnf_r >= 5) and not pnf_banned: {!<tr><td>!} -[+ pnf_name +] {!</td></tr>!} ?]

[? if ds_leader = "Carnazza" and ds_party and (pnf_r >= 5) : {!<tr><td>!} -PDSI {!</td></tr>!} ?]

[? if pcs_formed and (pnf_r >= 5) : {!<tr><td>!} -PCS {!</td></tr>!} ?]

[? if cc_formed and pnf_in_power : {!<tr><td>!} -CC {!</td></tr>!} ?]

[? if not ul_in_bn and pnf_in_power : {!<tr><td>!} -PLI (Def.) {!</td></tr>!} ?]

[? if pnf_in_power : {!<tr><td>!} -PPI (Def.) {!</td></tr>!} ?]

[? if cc_formed and not pnf_in_power : {!<tr><td><div class="box" style='background-color:#203959'> </div>!} <span style="color: [+ cc_colour +];">Christian-Conservative</span> List: {!</td><td>!} [+ cc_r_disp +]% {!</td><td>!} [+ str_change_cc +]% {!</td><td>!} [+ cc_seating +] {!</td><td>!} [+ cc_seating_disp +]% {!</td></tr>!} ?]

[? if cc_formed and not pnf_in_power : {!<tr><td>!} -CC {!</td></tr>!} ?]

{!<tr><td><div class="box" style='background-color:#a0a0a0'> </div>!} Others: {!</td><td>!} [+ other_r_disp +]% {!</td><td>!} [+ str_change_other +]% {!</td><td>!} [+ other_seating +] {!</td><td>!} [+ other_seating_disp +]% {!</td></tr>!}

[? if not pri_prominent : {!<tr><td>!} -PRI {!</td></tr>!} ?]

[? if not economic_right : {!<tr><td>!} -PE {!</td></tr>!} ?]

[? if not economic_right : {!<tr><td>!} -PA {!</td></tr>!} ?]

[? if pnf_r < 5 and not pnf_in_bn and not pnf_banned : {!<tr><td>!} -[+ pnf_name +] {!</td></tr>!} ?]

[? if pnf_in_power : {!<tr><td>!} -Constitutional Opposition {!</td></tr>!} ?]

[? if psri_solo and psri_r < 5 : {!<tr><td>!} -PSRI {!</td></tr>!} ?]

[? if pnf_in_power : {!<tr><td>!} -LI {!</td></tr>!} ?]

[? if abstentionist_psi : {!<tr><td><div class="box" style='background-color:#FFFFFF'> </div>!} Vacant: {!</td><td>!} N/A {!</td><td>!} N/A {!</td><td>!} [+ vacant_seating +] {!</td><td>!} [+ vacant_seating_disp +]% {!</td></tr>!} ?]
{!</table>!}

**Potential Coalitions:**

Left-Wing Coalition ([+ psi_name +] + PSRI [? if pri_allies :+ PRI?] [? if psu_coalitioning :+ PSU?] [? if ds_allies :+ [+ ds_name +]?] [? if pll_formed :+ PLL?]): [+ left_wing_coalition_r +]%

Centre-Left Coalition ([+ psi_name +] + PSRI + [+ ldr_name +] [? if pri_allies :+ PRI?] [? if ds_allies :+ [+ ds_name +]?] [? if ul_allies:+ [+ ul_name +]?] [? if pll_formed :+ PLL?]): [+ centre_left_coalition_r +]%

Socialist-Catholic Coalition ([+ psi_name +] + PSRI + PPI [? if pri_allies :+ PRI?] [? if ds_allies :+ [+ ds_name +] ?] [? if pll_formed :+ PLL?]): [+ socialist_catholic_coalition_r +]%
 
Grand Coalition (PSRI + PPI + [+ ldr_name +] + [+ ul_name +] + [+ ds_name +] + Others [? if pll_formed :+ PLL?]): [+ grand_coalition_r +]%

Centre-Right Coalition ([+ pnf_name +] + [+ ul_name +] [? if ds_enemies:+ [+ ds_name +]?] [? if ldr_enemies:+ [+ ldr_name +]?] [? if pcs_formed :+ PCS ?]): [+ centre_right_coalition_r +]%

Anti-Socialist Coalition ([+ pnf_name +] + [+ ul_name +] [? if ds_enemies:+ [+ ds_name +]?] [? if ldr_enemies:+ [+ ldr_name +]?]  [? if pcs_formed :+ PCS ?]): [+ anti_socialist_coalition_r +]%

[? if fasci_urgency <= 2 and pnf_seating_disp >= 15 : The rapid rise in [+ pnf_name +] votes is extremely worrying. Many had believed that the party was <span style="color: #d42f2f;">moribund</span>; now, some of us consider it to be the greatest obstacle to <span style="color: #9B0000;">socialism</span> in <span style="color: #008C45;">**It**</span><span style="color: #E5E4E2;">**a**</span><span style="color: #CD212A;">**ly**</span>. ?]

[? if abstentionist_psi : In accordance with the XVI Congress, all [+ psi_name +] deputies will refuse to take up their seats. ?]

[? if vacant_seating_disp >= 35 : Our strong showing even without taking up seats has reinvigorated the party towards <span style="color: #9B0000;">revolutionary</span> means. ?]

[? if prime_minister_party == pnf_name : Numerous deputies of the PPI, [+ ul_name +], [+ ds_name +] and [+ ldr_name +] have defected to the PNF. ?]

There are some potential coalition arrangements.

{!<svg id="italy_election3.svg" viewBox="0 0 4500 4000" width="4500" height="4000" style="display:block; margin:auto; border: 3px solid #3B3B3B;">
  <style>
    .district { fill: #b5b2a7; stroke: #000000; stroke-width: 2px; }
    .district:hover { fill: #d1cfc2; opacity: 0.8; cursor: pointer; }
