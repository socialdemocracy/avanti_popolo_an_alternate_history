} else {
    Q.treasury_minister_party = Q.ul_name; 
}
Q.agriculture_minister_party = "PNF"; 
if (Q.ldr_enemies == 1) {
    Q.public_education_minister_party = Q.ldr_name; 
} else {
    Q.public_education_minister_party = "PNF"; 
}
Q.public_works_minister_party = "PNF";
!}
