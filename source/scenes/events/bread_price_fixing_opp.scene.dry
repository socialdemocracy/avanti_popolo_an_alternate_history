view-if: year = 1920 and month = 6 and week = 1 and prime_minister = "Nitti"
on-arrival: {!
Q.yes_votes = 0;
Q.no_votes = 0;
Q.abstain_votes = 0;
Q.ul_opinion = "Si";
Q.bread_price_seen = 1;
Q.psri_opinion = "No";
Q.pri_opinion = "No";
Q.ds_opinion = "Si";
Q.ppi_opinion = "Abstain";
Q.ldr_opinion = "Si";
Q.pnf_opinion = "No";
Q.other_opinion = "Abstain";
