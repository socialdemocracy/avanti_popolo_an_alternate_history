if (Q.socialist_catholic_coalition == 1) {
    Q.ppi_extreme_left += 1;
}
if (Q.ppi_relation >= 70) {
    Q.ppi_extreme_left += 1;
}
if (Q.roman_question_answered == 1) {
    Q.ppi_extreme_left += 1;
}
if (Q.land_seizures == 1) {
    Q.ppi_extreme_left += 1;
}
if (Q.land_seizures >= 1) {
    Q.ppi_extreme_left += 2;
}
if (Q.socialist_catholic_coalition == 1) {
    Q.ppi_left += 1;
}
if (Q.ppi_relation >= 40) {
    Q.ppi_left += 1;
}
if (Q.pope === "Gasparri") {
    Q.ppi_left += 1;
}
if (Q.roman_question_answered == 1) {
