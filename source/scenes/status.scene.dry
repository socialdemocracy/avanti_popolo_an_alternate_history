title: Status
new-page: true
is-special: true
on-arrival: {!
if (Q.inflation) {
    Q.inflation_2 = Q.inflation.toFixed(1);
}
if (Q.economic_growth) {
    Q.economic_growth_2 = Q.economic_growth.toFixed(1);
}
if (Q.unemployment) {
    Q.unemployment_2 = Q.unemployment.toFixed(1);
}
Q.revolutionary_fervour = Math.round(Q.revolutionary_fervour);
var _newData = [];
    function _addP(id, legend, seats) {
        if (seats && seats > 0) _newData.push({ id: id, legend: legend, name: legend, seats: seats });
    }
    _addP('pcdi', "PCd'I", Q.pcdi_seating);
    _addP('psi', 'PSI', Q.psi_seating);
    _addP('psu', 'PSU', Q.psu_seating);
    _addP('psri', 'PSRI', Q.psri_seating);
    _addP('pll', 'PLL', Q.pll_seating);
    _addP('pri',  'PRI',  Q.pri_seating);
    _addP('ds', 'DS', Q.ds_seating);
    _addP('ds', 'PDSI', Q.ds_seating);
    _addP('ppi', 'PPI', Q.ppi_seating);
    _addP('ldr', 'LDR', Q.ldr_seating);
    _addP('ldr', 'PLDI', Q.ldr_seating);
    _addP('ul','UL',Q.ul_seating);
    _addP('ul', 'PLI', Q.ul_seating);
    _addP('cc', 'CC', Q.cc_seating);
    _addP('pcs','PCS',Q.pcs_seating);
    _addP('other', 'Others', Q.other_seating);
    _addP('pnf',  'FdC',  Q.pnf_seating);
    _addP('pnf',  'PNF',  Q.pnf_seating);

    var _newSig = JSON.stringify(_newData.map(function(p){ return p.id + p.seats; }));
    var _changed = (_newSig !== window._parliSig);
    window._parliData = _newData;
    if (_changed) {
        window._parliSig = _newSig;
        window._parliAnimate = true;
    } else {
        window._parliAnimate = false;
    }
!}

= Status

Week [+ week +], [+ month : month +] [+ year +]

Party: [+ resources +]

Paramilitary: [+ para_resources +]

<span style="color: [+ psi_colour +];">**[+ psi_name +]**</span> position: [? if psi_in_government : in government - ?][? if psi_in_government == 0 : opposition ?]
[? if centre_left_coalition and psi_in_government: <span style="color: [+ ul_colour +];">**Center**</span>-<span style="color: [+ psi_colour +];">**Left**</span> Coalition ?][? if psi_majority and psi_in_government: <span style="color: [+ psi_colour +];">**[+ psi_name +]**</span> majority ?][? if socialist_catholic_coalition and psi_in_government: <span style="color: [+ ppi_colour +];">**Catholic**</span>-<span style="color: [+ psi_colour +];">**Socialist**</span> Coalition ?][? if left_wing_coalition and psi_in_government: <span style="color: [+ psi_colour +];">**Left**</span>-<span style="color: [+ psri_colour +];">**Wing**</span> Coalition ?]

[? if psi_in_government and not psi_majority: Coalition dissent: [+ coalition_dissent : coalition_dissent +] ?]

Internal dissent: [+ dissent_percent : dissent +]

<span style="color: #693232;">**Revolutionary Fervour**</span>: [+ revolutionary_fervour +]%

[? if not_participating = 1: <span style="color: #700000;">**Revolutionary Exhaustion**</span>: [+ revolutionary_exhaustion_2 : exhaustion +] ?]

<span style="color: [+ communist_colour +];">**Radicalisation**</span>: [+ radicalisation : radicalisation +]

[? if prime_minister = "D'Annunzio" : Our relationship with D'Annunzio is [+ dannunzio_relation : radicalisation +] ?]

[? if prime_minister = "D'Annunzio" : D'Annunzio's influence within the party is [+ dannunzio_influence : influence +] ?]

= Government

[? if not king_abolished : King: <span style="color: [+ i_colour +];">**[+ king +]**</span> ?]

[? if not king_abolished and not king_figurehead : <span style="color: [+ i_colour +];">**King**</span> Approval: [+ king_relation : relationships +] ?]

Prime Minister: [? if prime_minister_party == "PSI": <span style="color: [+ psi_colour +];">[+ prime_minister +]</span>?][? if prime_minister_party == "LDR": <span style="color: [+ ldr_colour +];">[+ prime_minister +]</span>?][? if prime_minister_party == "PSRI": <span style="color: [+ psri_colour +];">[+ prime_minister +]</span>?][? if prime_minister_party == "UL": <span style="color: [+ ul_colour +];">[+ prime_minister +]</span>?][? if prime_minister_party == "PCd'I": <span style="color: [+ pcdi_colour +];">[+ prime_minister +]</span>?][? if prime_minister_party == "PSU": <span style="color: [+ psu_colour +];">[+ prime_minister +]</span>?][? if prime_minister_party == "PLL": <span style="color: [+ pll_colour +];">[+ prime_minister +]</span>?][? if prime_minister_party == "PRI": <span style="color: [+ pri_colour +];">[+ prime_minister +]</span>?][? if prime_minister_party == "DS": <span style="color: [+ ds_colour +];">[+ prime_minister +]</span>?][? if prime_minister_party == "PDSI": <span style="color: [+ pdsi_colour +];">[+ prime_minister +]</span>?][? if prime_minister_party == "PPI": <span style="color: [+ ppi_colour +];">[+ prime_minister +]</span>?][? if prime_minister_party == "PLDI": <span style="color: [+ pldi_colour +];">[+ prime_minister +]</span>?][? if prime_minister_party == "PLI": <span style="color: [+ pli_colour +];">[+ prime_minister +]</span>?][? if prime_minister_party == "PCS": <span style="color: [+ pcs_colour +];">[+ prime_minister +]</span>?][? if prime_minister_party == "FdC": <span style="color: [+ pnf_colour +];">[+ prime_minister +]</span>?][? if prime_minister_party == "PNF": <span style="color: [+ pnf_colour +];">[+ prime_minister +]</span>?] ([? if prime_minister_party == "PSI":<span style="color: [+ psi_colour +];">**[+ psi_name +]**</span>?][? if prime_minister_party == "LDR":<span style="color: [+ ldr_colour +];">**[+ ldr_name +]**</span>?][? if prime_minister_party == "PSRI":<span style="color: [+ psri_colour +];">**PSRI**</span>?][? if prime_minister_party == "UL":<span style="color: [+ ul_colour +];">**[+ ul_name +]**</span>?][? if prime_minister_party == "PCd'I":<span style="color: [+ pcdi_colour +];">**PCd'I**</span>?][? if prime_minister_party == "PSU":<span style="color: [+ psu_colour +];">**PSU**</span>?][? if prime_minister_party == "PLL":<span style="color: [+ pll_colour +];">**PLL**</span>?][? if prime_minister_party == "PRI":<span style="color: [+ pri_colour +];">**PRI**</span>?][? if prime_minister_party == "DS":<span style="color: [+ ds_colour +];">**[+ ds_name +]**</span>?][? if prime_minister_party == "PDSI":<span style="color: [+ ds_colour +];">**[+ ds_name +]**</span>?][? if prime_minister_party == "PPI":<span style="color: [+ ppi_colour +];">**PPI**</span>?][? if prime_minister_party == "PLDI":<span style="color: [+ ldr_colour +];">**[+ ldr_name +]**</span>?][? if prime_minister_party == "PLI":<span style="color: [+ pli_colour +];">**[+ pli_name +]**</span>?][? if prime_minister_party == "PLI":<span style="color: [+ ul_colour +];">**[+ ul_name +]**</span>?][? if prime_minister_party == "PCS":<span style="color: [+ pcs_colour +];">**PCS**</span>?][? if prime_minister_party == "FdC":<span style="color: [+ pnf_colour +];">**[+ pnf_name +]**</span>?][? if prime_minister_party == "PNF":<span style="color: [+ pnf_colour +];">**[+ pnf_name +]**</span>?])

Senate: [? if veto_removed == 0: Empowered ?][? if veto_removed == 1: Weakened ?]

Chamber of Deputies composition:

{!<svg id="status_parliament" style="width: 100%; display: block;"></svg>
<script>
(function() {
    if (!d3 || !d3.parliament || !window._parliData || window._parliData.length === 0) return;
    var el = document.getElementById('status_parliament');
    if (!el) return;
    var w = el.parentElement.offsetWidth || 220;
    el.setAttribute('width', w);
    el.setAttribute('height', Math.round(w * 0.55));
    var parl = d3.parliament();
    parl.width(w).height(Math.round(w * 0.55)).innerRadiusCoef(0.4);
    var animate = window._parliAnimate;
    parl.enter.fromCenter(animate).smallToBig(animate);
    parl.exit.toCenter(animate).bigToSmall(animate);
    d3.select('#status_parliament').datum(window._parliData).call(parl);
})();
</script>!}

<span style="color: [+ psi_colour +];">**[+ psi_name +]**</span>: [+ psi_seating_disp +]% 
[? if pcdi_formed : <span style="color: [+ pcdi_colour +];">**PCd'I**</span>: [+ pcdi_seating_disp +]% ?]
[? if psu_formed : <span style="color: [+ psu_colour +];">**PSU**</span>: [+ psu_seating_disp +]% ?]
