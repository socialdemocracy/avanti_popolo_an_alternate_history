= Party Leadership

[? if pcdi_formed: PCd'I: [? if pcdi_leader = "Bordiga": <span style="color: #C43988;">Left-Communism</span> ?][? if pcdi_leader = "Gramsci": <span style="color: #ab5757;">Western Marxism</span>?] ([+ pcdi_leader +]) ?]

[? if psu_formed: PSU: <span style="color: [+ reformist_colour +];"><span;">Reformist Socialism</span></span> (<span class="wide_tooltip-wrap drop-down">Quadrumvirate<span class="wide_tooltip-tip"><img src="img/psu.webp">Giacomo Matteoti</br>Filippo Turati</br>Carlo Rosselli</br>Giuseppe Saragat</span></span>) ?]

[? if pll_formed: PLL: <span style="color: #fb925d;">Liberal Socialism</span> (Giuffrida) ?]

[? if not psri_collapse: PSRI: [? if not psri_solo: <span style="color: [+ psri_colour +];"><span;">Reformist Socialism</span></span> to <span style="color: #dbd325;">Social-Liberalism</span>  ?][? if psri_solo: <span style="color: #dbd325;">Social-Liberalism</span> ?] ([? if psri_solo:Bonomi?][? if not psri_solo and not bissolati_dead:Bissolati?][? if not psri_solo and bissolati_dead:Ciotti?]) ?]

[? if pri_prominent: PRI: <span style="color: #008C45;">Repu</span><span style="color: #CCC;">blica</span><span style="color: #CD212A;">nism</span> to <span style="color: #00542E;">Radicalism</span>  ([? if year < 1920 and month < 4:<span class="wide_tooltip-wrap drop-down">Triumvirate<span class="wide_tooltip-tip"><img src="img/pribetter.webp">June 1919 - December 1919</br>Carlo Bazzi</br>Oliverio Zuccarini</br>Armando Casalini</br>December 1919 - April 1920</br>Armando Casalini</br>Mario Gibelli</br>Giuseppe Gaudenzi</span></span>?][? if year > 1920 and month > 4:<span class="wide_tooltip-wrap drop-down">Several<span class="wide_tooltip-tip"><img src="img/pribetter.webp">April 1920 - November 1922</br>Fernando Schiavetti</br>December 1922 – May 1925</br>Giuseppe Gaudenzi</span></span>?]) ?]

[+ ds_name +]: [? if ds_leader = "Giuffrida": <span style="color: #dbd325;">Social-Liberalism</span> to <span style="color: #00542E;">Radicalism</span> ?][? if ds_leader = "Colonna": <span style="color: #808080;">Syncretic</span>?][? if ds_leader = "Carnazza": <span style="color: #063547;">National Conservatism</span>?] ([+ ds_leader +]) 

PPI: [? if ppi_leader = "Sturzo": <span style="color: #94c5d1;">Popolarism</span> ?][? if ppi_leader = "De Gasperi": <span style="color: #62929e;">Christian Democracy</span>?][? if ppi_leader = "Miglioli": <span style="color: #27c488;">Religious Social-Agrarianism</span>?] ([+ ppi_leader +]) 

[+ ldr_name +]: [? if ldr_leader = "Nitti": <span style="color: #f5ee5d;"><span;">Reformist Liberalism</span></span> ?][? if ldr_leader = "Orlando": <span style="color: #e8e376;">Economic Liberalism</span> ?][? if ldr_leader = "Salandra": <span style="color: #063547;">National Conservatism</span>?] ([+ ldr_leader +]) 

[? if not pldi_merge: [+ ul_name +]: [? if ul_leader = "Giolitti": <span style="color: #1E87B2;">Giolittian System</span> ?][? if ul_leader = "Salandra": <span style="color: #063547;">National Conservatism</span>?] ([+ ul_leader +]) ?]

[? if cc_formed: CC: <span style="color: #022838;">Clerical Ultra-Conservatism</span> (Cavazzoni) ?]

[? if pcs_formed: PCS: <span style="color: #021a24;">Reactionary Conservatism</span> (Carnazza) ?]

[+ pnf_name +]: [? if pnf_leader = "D'Annunzio": <span style="color: #111c1c;"><span;">Futurist Proto-Fascism</span></span> ?][? if pnf_leader = "Grand Council": <span style="color: #0a0900;">Classical Fascism</span> ?][? if pnf_leader = "Mussolini": <span style="color: #0a0900;">Classical Fascism</span>?][? if pnf_leader = "Grandi": <span style="color: #0a0900;">Classical Fascism</span>?] ([+ pnf_leader +]) 

