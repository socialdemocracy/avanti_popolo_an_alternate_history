425],[-121.333468053867,37.8086300262006],[-121.335384054567,37.8121140263628],[-121.332965054879,37.8180530270528],[-121.339655056391,37.8221730269224],[-121.342116056206,37.8172770263197],[-121.348036057644,37.8217870262789],[-121.353895057988,37.8169180254314],[-121.376260062067,37.8222700242658],[-121.383959062031,37.8116650227895],[-121.414167065735,37.8033210198712],[-121.405770064222,37.8014520203208],[-121.391336062401,37.8049940216766],[-121.370628058659,37.8003260227795],[-121.362070056078,37.7894330224595],[-121.351389054432,37.7894950232411],[-121.349495053571,37.7845700229523],[-121.340049051725,37.7812440233504],[-121.329588048818,37.770075023142],[-121.325699048367,37.7713900235383],[-121.318174046389,37.764330023472],[-121.327205046636,37.7543240219487],[-121.326201045535,37.746102021308],[-121.339008047408,37.7451420202963],[-121.343879048537,37.7484110202267],[-121.343834047854,37.7425270197197],[-121.381543050648,37.7160640146939],[-121.379834049779,37.7107890143603],[-121.416239055368,37.7104910116997],[-121.416388054053,37.6988180106785],[-121.421182054796,37.6988410103337],[-121.421172054473,37.6960360100916],[-121.434605056543,37.6960110091179],[-121.434415054575,37.679075007666],[-121.444870055599,37.6739290064652],[-121.434310052213,37.658548005896],[-121.458039057329,37.6712990052862],[-121.467413057863,37.66333100392],[-121.474382058776,37.6619180032946],[-121.466851058792,37.6722110047285],[-121.476650059382,37.6641670033252],[-121.481831060476,37.6667560031748],[-121.493701064461,37.6856070039449],[-121.491664064943,37.6925500046915],[-121.50637906827,37.7018100044254],[-121.512677069085,37.7004660038537],[-121.532607072652,37.7048350027873],[-121.556971076255,37.7035860009156],[-121.556949089347,37.8172230106708],[-121.553524088956,37.8183910110205],[-121.549472090092,37.8335740126163],[-121.544200089162,37.8325500129131],[-121.538064088823,37.8377650138073],[-121.534115089572,37.8494620150975],[-121.540733090586,37.8494180146107],[-121.540656091524,37.857602015317],[-121.547509092303,37.8552310146137],[-121.552849093816,37.8611870147333],[-121.55526809382,37.8580120142851],[-121.560339094668,37.8586010139651],[-121.561990094288,37.8531430133778],[-121.56591609544,37.8578680134952],[-121.570467096107,37.857590013139],[-121.568991096228,37.8605780135023],[-121.578034097298,37.8578260126066],[-121.580249098014,37.8610620127213],[-121.584480097825,37.8538350117948],[-121.591149098741,37.8529060112285],[-121.592692098376,37.8477180106727],[-121.625030103053,37.8452430081007],[-121.625731103946,37.8520000086259],[-121.629567104957,37.8556420086562],[-121.653279109966,37.8674480079293],[-121.659622110937,37.8674320074642],[-121.663213112769,37.8784420081383],[-121.667816113487,37.8785490078107]]]}}]};

    var PARTIES = {
        KPD:   { name: "KPD",   color: "#700000" },
        SPD:   { name: "SPD",   color: "#c00000" },
        DDP:   { name: Q.ddp_name || "DDP", color: "#D3C24D" },
        Z:     { name: "Center", color: "#000000" },
        DVP:   { name: "DVP",   color: "#D5AC27" },
        DNVP:  { name: "DNVP",  color: "#3E88B3" },
        NSDAP: { name: "NSDAP", color: "#7A3C00" },
        Other: { name: "Other", color: "#8C8C8C" }
    };

    var partyShare = {
        SPD: Q.spd_votes || 0,
        KPD: Q.kpd_votes || 0,
        Z: Q.z_votes || 0,
        DDP: Q.ddp_votes || 0,
        DVP: Q.dvp_votes || 0,
        DNVP: Q.dnvp_votes || 0,
        NSDAP: Q.nsdap_votes || 0,
        Other: Q.other_votes || 0
    };
    var totalShare = 0;
    for (var k in partyShare) totalShare += partyShare[k];

    function pickParty() {
        var r = Math.random() * totalShare;
        var acc = 0;
        for (var k in partyShare) {
            acc += partyShare[k];
            if (r <= acc) return k;
        }
        return "Other";
    }

    geojson.features.forEach(function(f) {
        f.properties.PARTY = pickParty();
    });

    // --- draw the map ---
    var width = 640, height = 720;
    var svgEl = document.getElementById("ca-poll-svg");
    var contentWidth = document.getElementById("content").offsetWidth;
    if (contentWidth < width) {
        width = contentWidth;
        height = width * (720 / 640);
        svgEl.style.height = height + "px";
    }

    var projection = d3.geoAlbers().fitSize([width, height], geojson);
    var path = d3.geoPath(projection);

    d3.select("#ca-poll-svg")
        .selectAll("path")
        .data(geojson.features)
        .join("path")
            .attr("d", path)
            .attr("fill", function(d) { return PARTIES[d.properties.PARTY].color; })
            .attr("stroke", "#0f1115")
            .attr("stroke-width", 0.6)
            .style("cursor", "pointer")
            .on("mouseover", function() { d3.select(this).style("opacity", 0.85); })
            .on("mouseout", function() { d3.select(this).style("opacity", 1); })
            .on("click", function(event, d) {
                Q['selected_district'] = d.properties.DISTRICT;
                var p = PARTIES[d.properties.PARTY];
                document.getElementById("ca-poll-detail").innerHTML =
                    "<strong>District " + d.properties.DISTRICT + "</strong><br>" + p.name;
            })
        .append("title")
            .text(function(d) { return "District " + d.properties.DISTRICT + " — " + PARTIES[d.properties.PARTY].name; });

    // --- seat counts + vote share, feeding both the table and the hemicycle ---
    var seatCounts = {};
    for (var k2 in PARTIES) seatCounts[k2] = 0;
    geojson.features.forEach(function(f) { seatCounts[f.properties.PARTY]++; });

    var totalSeats = geojson.features.length;

    // --- results table, styled like the Saxony scene's party table ---
    var tableHtml = "<table>";
    tableHtml += "<tr><td>Party</td><td>Vote share</td><td>Districts won</td></tr>";
    for (var k3 in PARTIES) {
        if (!seatCounts[k3]) continue;
        var voteShare = ((partyShare[k3] / totalShare) * 100).toFixed(1);
        var seatShare = ((seatCounts[k3] / totalSeats) * 100).toFixed(1);
        tableHtml += "<tr><td><div class='box' style='background-color:" + PARTIES[k3].color + "; outline: 2px; outline-style: solid;'> </div> </td>" +
            "<td>" + PARTIES[k3].name + ": " + voteShare + "%</td>" +
            "<td>" + seatCounts[k3] + " (" + seatShare + "%)</td></tr>";
    }
    tableHtml += "</table>";
    document.getElementById("ca-poll-tally").innerHTML = tableHtml;

    // --- parliament hemicycle, same seat counts, same visual convention as Saxony ---
    if (window && d3 && d3.parliament) {
        var width2 = 500;
        var height2 = 500;
        var screenWidth = document.getElementById('content').offsetWidth;
        if (screenWidth < width2 - 50) {
            width2 = screenWidth - 50;
            height2 = width2;
            document.getElementById("ca-poll-hemicycle").style.height = screenWidth/2 + "px";
        }
        var hemiData = [];
        for (var k4 in PARTIES) {
            if (!seatCounts[k4]) continue;
            hemiData.push({ id: k4, legend: PARTIES[k4].name, name: PARTIES[k4].name, seats: seatCounts[k4] });
        }
        var parliament = d3.parliament();
        parliament.width(width2).height(height2).innerRadiusCoef(0.4);
        parliament.enter.fromCenter(true).smallToBig(true);
        parliament.exit.toCenter(false).bigToSmall(true);
        d3.select("#ca-poll-hemicycle").datum(hemiData).call(parliament);
        setTimeout(function() {
            d3.select("#ca-poll-hemicycle").selectAll(".seat")
                .attr("fill", function(d) { return PARTIES[d.party.id].color; });
        }, );
    }
!}

A test run of the district map, driven by the current national polling numbers instead of random data.

